{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "region": {
      "type": "string",
      "defaultValue": "westus3",
      "metadata": {
        "description": "Region for all resources."
      }
    },
    "dbAdminPassword": {
      "type": "secureString",
      "defaultValue": "Replace-Me-StrongPassword-123!",
      "metadata": {
        "description": "Administrator password for PostgreSQL servers."
      }
    },
    "sshRSAPublicKey": {
      "type": "string",
      "metadata": {
        "description": "SSH RSA public key for the AKS nodes (required for ARM deployment)."
      }
    }
  },
  "variables": {
    "rgDev": "rg-petclinic-dev",
    "rgTest": "rg-petclinic-testing",
    "rgProd": "rg-petclinic-prod",
    "rgAks": "rg-petclinic-aks",

    "uniqueSuffix": "[substring(uniqueString(subscription().subscriptionId, parameters('region')), 0, 6)]",

    "aksName": "aks-petclinic",
    "acrDev":  "[format('acrpetclinicdev{0}',  variables('uniqueSuffix'))]",
    "acrTest": "[format('acrpetclinictest{0}', variables('uniqueSuffix'))]",
    "acrProd": "[format('acrpetclinicprod{0}', variables('uniqueSuffix'))]",

    "dbDev":  "[format('db-petclinic-dev-{0}',     variables('uniqueSuffix'))]",
    "dbTest": "[format('db-petclinic-testing-{0}', variables('uniqueSuffix'))]",
    "dbProd": "[format('db-petclinic-prod-{0}',    variables('uniqueSuffix'))]",

    "acrPullRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]"
  },
  "resources": [

    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[variables('rgDev')]",
      "location": "[parameters('region')]"
    },
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[variables('rgTest')]",
      "location": "[parameters('region')]"
    },
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[variables('rgProd')]",
      "location": "[parameters('region')]"
    },
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2021-04-01",
      "name": "[variables('rgAks')]",
      "location": "[parameters('region')]"
    },

    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "Deploy-AKS",
      "resourceGroup": "[variables('rgAks')]",
      "dependsOn": [
        "[variables('rgAks')]"
      ],
      "properties": {
        "expressionEvaluationOptions": { "scope": "inner" },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "aksName":        { "type": "string" },
            "region":         { "type": "string" },
            "sshRSAPublicKey":{ "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerService/managedClusters",
              "apiVersion": "2023-08-01",
              "name": "[parameters('aksName')]",
              "location": "[parameters('region')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "dnsPrefix": "petclinic",
                "agentPoolProfiles": [
                  {
                    "name": "agentpool",
                    "count": 2,
                    "vmSize": "Standard_D2s_v4",
                    "osType": "Linux",
                    "mode": "System"
                  }
                ],
                "linuxProfile": {
                  "adminUsername": "azureuser",
                  "ssh": {
                    "publicKeys": [
                      {
                        "keyData": "[parameters('sshRSAPublicKey')]"
                      }
                    ]
                  }
                },
                "networkProfile": {
                  "networkPlugin": "kubenet"
                }
              }
            }
          ],
          "outputs": {
            "kubeletObjectId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('aksName')), '2023-08-01', 'Full').properties.identityProfile.kubeletidentity.objectId]"
            }
          }
        },
        "parameters": {
          "aksName":         { "value": "[variables('aksName')]" },
          "region":          { "value": "[parameters('region')]" },
          "sshRSAPublicKey": { "value": "[parameters('sshRSAPublicKey')]" }
        }
      }
    },

    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "Deploy-PetClinic-Dev",
      "resourceGroup": "[variables('rgDev')]",
      "dependsOn": [
        "[variables('rgDev')]",
        "Deploy-AKS"
      ],
      "properties": {
        "expressionEvaluationOptions": { "scope": "inner" },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "kubeletObjectId": { "type": "string" },
            "acrName":         { "type": "string" },
            "dbName":          { "type": "string" },
            "region":          { "type": "string" },
            "dbAdminPassword": { "type": "secureString" },
            "acrPullRoleId":   { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[parameters('acrName')]",
              "location": "[parameters('region')]",
              "sku": { "name": "Basic" },
              "properties": { "adminUserEnabled": true }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().name, parameters('acrName'), 'kubelet-acrpull')]",
              "dependsOn": [
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
              ],
              "properties": {
                "roleDefinitionId": "[parameters('acrPullRoleId')]",
                "principalId": "[parameters('kubeletObjectId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers",
              "apiVersion": "2022-12-01",
              "name": "[parameters('dbName')]",
              "location": "[parameters('region')]",
              "sku": { "name": "Standard_B1ms", "tier": "Burstable" },
              "properties": {
                "administratorLogin": "petclinic_admin",
                "administratorLoginPassword": "[parameters('dbAdminPassword')]",
                "version": "13",
                "storage": { "storageSizeGB": 32 },
                "network": { "delegatedSubnetResourceId": null, "privateDnsZoneArmResourceId": null }
              },
              "resources": [
                {
                  "type": "databases",
                  "apiVersion": "2022-12-01",
                  "name": "petclinic",
                  "dependsOn": [
                    "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbName'))]"
                  ],
                  "properties": { "charset": "UTF8", "collation": "en_US.utf8" }
                },
                {
                  "type": "firewallRules",
                  "apiVersion": "2022-12-01",
                  "name": "AllowAzureServices",
                  "dependsOn": [
                    "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbName'))]"
                  ],
                  "properties": { "startIpAddress": "0.0.0.0", "endIpAddress": "0.0.0.0" }
                }
              ]
            }
          ]
        },
        "parameters": {
          "kubeletObjectId": {
            "value": "[reference(resourceId(subscription().subscriptionId, variables('rgAks'), 'Microsoft.Resources/deployments', 'Deploy-AKS'), '2021-04-01').outputs.kubeletObjectId.value]"
          },
          "acrName":         { "value": "[variables('acrDev')]" },
          "dbName":          { "value": "[variables('dbDev')]" },
          "region":          { "value": "[parameters('region')]" },
          "dbAdminPassword": { "value": "[parameters('dbAdminPassword')]" },
          "acrPullRoleId":   { "value": "[variables('acrPullRoleId')]" }
        }
      }
    },

    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "Deploy-PetClinic-Test",
      "resourceGroup": "[variables('rgTest')]",
      "dependsOn": [
        "[variables('rgTest')]",
        "Deploy-AKS"
      ],
      "properties": {
        "expressionEvaluationOptions": { "scope": "inner" },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "kubeletObjectId": { "type": "string" },
            "acrName":         { "type": "string" },
            "dbName":          { "type": "string" },
            "region":          { "type": "string" },
            "dbAdminPassword": { "type": "secureString" },
            "acrPullRoleId":   { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[parameters('acrName')]",
              "location": "[parameters('region')]",
              "sku": { "name": "Basic" },
              "properties": { "adminUserEnabled": true }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().name, parameters('acrName'), 'kubelet-acrpull')]",
              "dependsOn": [
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
              ],
              "properties": {
                "roleDefinitionId": "[parameters('acrPullRoleId')]",
                "principalId": "[parameters('kubeletObjectId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers",
              "apiVersion": "2022-12-01",
              "name": "[parameters('dbName')]",
              "location": "[parameters('region')]",
              "sku": { "name": "Standard_B1ms", "tier": "Burstable" },
              "properties": {
                "administratorLogin": "petclinic_admin",
                "administratorLoginPassword": "[parameters('dbAdminPassword')]",
                "version": "13",
                "storage": { "storageSizeGB": 32 }
              },
              "resources": [
                {
                  "type": "databases",
                  "apiVersion": "2022-12-01",
                  "name": "petclinic",
                  "dependsOn": [
                    "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbName'))]"
                  ],
                  "properties": { "charset": "UTF8", "collation": "en_US.utf8" }
                },
                {
                  "type": "firewallRules",
                  "apiVersion": "2022-12-01",
                  "name": "AllowAzureServices",
                  "dependsOn": [
                    "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbName'))]"
                  ],
                  "properties": { "startIpAddress": "0.0.0.0", "endIpAddress": "0.0.0.0" }
                }
              ]
            }
          ]
        },
        "parameters": {
          "kubeletObjectId": {
            "value": "[reference(resourceId(subscription().subscriptionId, variables('rgAks'), 'Microsoft.Resources/deployments', 'Deploy-AKS'), '2021-04-01').outputs.kubeletObjectId.value]"
          },
          "acrName":         { "value": "[variables('acrTest')]" },
          "dbName":          { "value": "[variables('dbTest')]" },
          "region":          { "value": "[parameters('region')]" },
          "dbAdminPassword": { "value": "[parameters('dbAdminPassword')]" },
          "acrPullRoleId":   { "value": "[variables('acrPullRoleId')]" }
        }
      }
    },

    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "Deploy-PetClinic-Prod",
      "resourceGroup": "[variables('rgProd')]",
      "dependsOn": [
        "[variables('rgProd')]",
        "Deploy-AKS"
      ],
      "properties": {
        "expressionEvaluationOptions": { "scope": "inner" },
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "kubeletObjectId": { "type": "string" },
            "acrName":         { "type": "string" },
            "dbName":          { "type": "string" },
            "region":          { "type": "string" },
            "dbAdminPassword": { "type": "secureString" },
            "acrPullRoleId":   { "type": "string" }
          },
          "resources": [
            {
              "type": "Microsoft.ContainerRegistry/registries",
              "apiVersion": "2023-07-01",
              "name": "[parameters('acrName')]",
              "location": "[parameters('region')]",
              "sku": { "name": "Basic" },
              "properties": { "adminUserEnabled": true }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().name, parameters('acrName'), 'kubelet-acrpull')]",
              "dependsOn": [
                "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]"
              ],
              "properties": {
                "roleDefinitionId": "[parameters('acrPullRoleId')]",
                "principalId": "[parameters('kubeletObjectId')]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers",
              "apiVersion": "2022-12-01",
              "name": "[parameters('dbName')]",
              "location": "[parameters('region')]",
              "sku": { "name": "Standard_B1ms", "tier": "Burstable" },
              "properties": {
                "administratorLogin": "petclinic_admin",
                "administratorLoginPassword": "[parameters('dbAdminPassword')]",
                "version": "13",
                "storage": { "storageSizeGB": 32 }
              },
              "resources": [
                {
                  "type": "databases",
                  "apiVersion": "2022-12-01",
                  "name": "petclinic",
                  "dependsOn": [
                    "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbName'))]"
                  ],
                  "properties": { "charset": "UTF8", "collation": "en_US.utf8" }
                },
                {
                  "type": "firewallRules",
                  "apiVersion": "2022-12-01",
                  "name": "AllowAzureServices",
                  "dependsOn": [
                    "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('dbName'))]"
                  ],
                  "properties": { "startIpAddress": "0.0.0.0", "endIpAddress": "0.0.0.0" }
                }
              ]
            }
          ]
        },
        "parameters": {
          "kubeletObjectId": {
            "value": "[reference(resourceId(subscription().subscriptionId, variables('rgAks'), 'Microsoft.Resources/deployments', 'Deploy-AKS'), '2021-04-01').outputs.kubeletObjectId.value]"
          },
          "acrName":         { "value": "[variables('acrProd')]" },
          "dbName":          { "value": "[variables('dbProd')]" },
          "region":          { "value": "[parameters('region')]" },
          "dbAdminPassword": { "value": "[parameters('dbAdminPassword')]" },
          "acrPullRoleId":   { "value": "[variables('acrPullRoleId')]" }
        }
      }
    }

  ],
  "outputs": {
    "aksClusterName": {
      "type": "string",
      "value": "[variables('aksName')]"
    },
    "acrDevName": {
      "type": "string",
      "value": "[variables('acrDev')]"
    }
  }
}
